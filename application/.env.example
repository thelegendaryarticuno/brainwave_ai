# AI: GitHub Models free tier (OpenAI-compatible)
AI_MODEL_SMART="openai/gpt-4.1"
AI_MODEL_FAST="openai/gpt-4.1-mini"
GITHUB_TOKEN="your_github_models_token_here"
GITHUB_MODELS_API_BASE_URL=https://models.github.ai/inference
# Any OpenAI-compatible provider works: set these to override the GitHub Models values above, e.g.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=sk-...
# AI_MODEL_SMART=openai/gpt-oss-120b
# AI_MODEL_FAST=openai/gpt-oss-20b
